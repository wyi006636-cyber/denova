{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiaping discovery artifacts v1",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/candidates" },
    { "$ref": "#/$defs/proposals" },
    { "$ref": "#/$defs/clusters" },
    { "$ref": "#/$defs/shortlist" },
    { "$ref": "#/$defs/lexicon" }
  ],
  "$defs": {
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "snapshot_id", "status", "started_at", "completed_at", "base_url", "normalization_version", "reported_total", "unique_skills", "pages", "failures", "skill_records_sha256", "provenance"],
      "properties": {
        "contract": {"const": "denova.xiaping-snapshot-manifest"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "status": {"enum": ["COMPLETE", "PARTIAL"]},
        "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "base_url": {"type": "string"}, "normalization_version": {"type": "string"}, "reported_total": {"type": "integer", "minimum": 0}, "unique_skills": {"type": "integer", "minimum": 0}, "pages": {"type": "array"}, "failures": {"type": "array"}, "previous_snapshot_sha256": {"type": "string"}, "skill_records_sha256": {"type": "string"}, "provenance": {"$ref":"#/$defs/provenance"}
      }
    },
    "candidates": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "candidates", "provenance"], "properties": {"contract": {"const": "denova.xiaping-writing-candidates"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "candidates": {"type": "array", "items":{"$ref":"#/$defs/candidate"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "proposals": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "proposals", "provenance"], "properties": {"contract": {"const": "denova.xiaping-capability-proposals"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "proposals": {"type": "array", "items":{"type":"object"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "clusters": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "clusters", "provenance"], "properties": {"contract": {"const": "denova.xiaping-duplicate-clusters"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "clusters": {"type": "array", "items":{"type":"object"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "shortlist": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "entries", "gaps", "provenance"], "properties": {"contract": {"const": "denova.xiaping-evidence-shortlist"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "entries": {"type": "array", "items":{"type":"object"}}, "gaps": {"type": "array", "items":{"type":"object"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["source","purpose","input_sha256","max_bytes"],"properties":{"source":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"input_sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"max_bytes":{"type":"integer","minimum":131073}}},
    "candidate": {"type":"object","additionalProperties":false,"required":["skill","profiles","capabilities"],"properties":{"skill":{"$ref":"#/$defs/skill"},"profiles":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"$ref":"#/$defs/capability_match"}}}},
    "skill": {"type":"object","additionalProperties":false,"required":["id","name","description","triggers","categories","tags","owner_id","owner_name","current_version","downloads","average_stars_x100","star_count","comment_count","featured","platform_status","security_status","version_count","created_at","updated_at","detail_url"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string"},"description":{"type":"string"},"triggers":{"type":"array","items":{"type":"string"}},"categories":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"owner_id":{"type":"string"},"owner_name":{"type":"string"},"current_version":{"type":"string"},"downloads":{"type":"integer","minimum":0},"average_stars_x100":{"type":"integer","minimum":0},"star_count":{"type":"integer","minimum":0},"comment_count":{"type":"integer","minimum":0},"featured":{"type":"boolean"},"platform_status":{"type":"string"},"security_status":{"type":"string"},"version_count":{"type":"integer","minimum":0},"created_at":{"type":"string"},"updated_at":{"type":"string"},"detail_url":{"type":"string"}}},
    "capability_match": {"type":"object","additionalProperties":false,"required":["capability_id","status","evidence"],"properties":{"capability_id":{"type":"string","minLength":1},"status":{"enum":["MATCHED","AMBIGUOUS","NOT-MATCHED"]},"evidence":{"type":"array","items":{"$ref":"#/$defs/field_evidence"}}}},
    "field_evidence": {"type":"object","additionalProperties":false,"required":["field","term"],"properties":{"field":{"type":"string"},"term":{"type":"string"}}},
    "lexicon": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "include_terms", "exclude_terms", "core_capabilities", "proposal_rules"], "properties": {"contract": {"const": "denova.xiaping-capability-lexicon"}, "version": {"const": "v1"}, "include_terms": {"type": "array"}, "exclude_terms": {"type": "array"}, "core_capabilities": {"type": "array"}, "proposal_rules": {"type": "array"}}}
  }
}
