{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiaping discovery artifacts v1",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/candidates" },
    { "$ref": "#/$defs/proposals" },
    { "$ref": "#/$defs/clusters" },
    { "$ref": "#/$defs/shortlist" },
    { "$ref": "#/$defs/lexicon" }
  ],
  "$defs": {
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "snapshot_id", "status", "started_at", "completed_at", "base_url", "normalization_version", "reported_total", "unique_skills", "pages", "failures", "skill_records_sha256", "provenance"],
      "properties": {
        "contract": {"const": "denova.xiaping-snapshot-manifest"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "status": {"enum": ["COMPLETE", "PARTIAL"]},
        "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "base_url": {"type": "string"}, "normalization_version": {"type": "string"}, "reported_total": {"type": "integer", "minimum": 0}, "unique_skills": {"type": "integer", "minimum": 0}, "pages": {"type": "array", "items":{"$ref":"#/$defs/pageReceipt"}}, "failures": {"type": "array", "items":{"$ref":"#/$defs/snapshotFailure"}}, "previous_snapshot_sha256": {"type": "string"}, "skill_records_sha256": {"type": "string"}, "provenance": {"$ref":"#/$defs/provenance"}
      }
    },
    "candidates": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "candidates", "provenance"], "properties": {"contract": {"const": "denova.xiaping-writing-candidates"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "candidates": {"type": "array", "items":{"$ref":"#/$defs/candidate"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "proposals": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "proposals", "provenance"], "properties": {"contract": {"const": "denova.xiaping-capability-proposals"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "proposals": {"type": "array", "items":{"$ref":"#/$defs/proposal"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "clusters": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "clusters", "provenance"], "properties": {"contract": {"const": "denova.xiaping-duplicate-clusters"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "clusters": {"type": "array", "items":{"$ref":"#/$defs/cluster"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "shortlist": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "snapshot_id", "entries", "gaps", "provenance"], "properties": {"contract": {"const": "denova.xiaping-evidence-shortlist"}, "version": {"const": "v1"}, "snapshot_id": {"type": "string", "minLength": 1}, "entries": {"type": "array", "items":{"$ref":"#/$defs/entry"}}, "gaps": {"type": "array", "items":{"$ref":"#/$defs/gap"}}, "provenance":{"$ref":"#/$defs/provenance"}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["source","purpose","input_sha256","max_bytes"],"properties":{"source":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"input_sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"max_bytes":{"const":2097152}}},
    "candidate": {"type":"object","additionalProperties":false,"required":["skill","profiles","capabilities"],"properties":{"skill":{"$ref":"#/$defs/skill"},"profiles":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"$ref":"#/$defs/capability_match"}}}},
    "skill": {"type":"object","additionalProperties":false,"required":["id","name","description","triggers","categories","tags","owner_id","owner_name","current_version","downloads","average_stars_x100","star_count","comment_count","featured","platform_status","security_status","version_count","created_at","updated_at","detail_url"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string"},"description":{"type":"string"},"triggers":{"type":"array","items":{"type":"string"}},"categories":{"type":"array","items":{"type":"string"}},"tags":{"type":"array","items":{"type":"string"}},"owner_id":{"type":"string"},"owner_name":{"type":"string"},"current_version":{"type":"string"},"downloads":{"type":"integer","minimum":0},"average_stars_x100":{"type":"integer","minimum":0},"star_count":{"type":"integer","minimum":0},"comment_count":{"type":"integer","minimum":0},"featured":{"type":"boolean"},"platform_status":{"type":"string"},"security_status":{"type":"string"},"version_count":{"type":"integer","minimum":0},"created_at":{"type":"string"},"updated_at":{"type":"string"},"detail_url":{"type":"string"}}},
    "capability_match": {"type":"object","additionalProperties":false,"required":["capability_id","status","evidence"],"properties":{"capability_id":{"type":"string","minLength":1},"status":{"enum":["MATCHED","AMBIGUOUS","NOT-MATCHED"]},"evidence":{"type":"array","items":{"$ref":"#/$defs/field_evidence"}}}},
    "field_evidence": {"type":"object","additionalProperties":false,"required":["field","term"],"properties":{"field":{"type":"string"},"term":{"type":"string"}}},
    "proposal": {"type":"object","additionalProperties":false,"required":["capability_id","name_zh","name_en","inputs","outputs","lifecycle_stage","minimum_permission","evaluation_method","candidate_ids"],"properties":{"capability_id":{"type":"string","minLength":1},"name_zh":{"type":"string"},"name_en":{"type":"string"},"inputs":{"type":"array","items":{"type":"string"}},"outputs":{"type":"array","items":{"type":"string"}},"lifecycle_stage":{"type":"string"},"minimum_permission":{"type":"string"},"evaluation_method":{"type":"string"},"candidate_ids":{"type":"array","items":{"type":"string"}}}},
    "cluster": {"type":"object","additionalProperties":false,"required":["cluster_id","kind","representative_id","member_ids","reasons"],"properties":{"cluster_id":{"type":"string","minLength":1},"kind":{"type":"string"},"representative_id":{"type":"string","minLength":1},"member_ids":{"type":"array","items":{"type":"string","minLength":1}},"reasons":{"type":"array","items":{"type":"string"}}}},
    "review": {"type":"object","additionalProperties":false,"required":["effective_raters","substantive_comments","duplicate_comments","owner_self_reviews","average_stars_x100","anomaly_flags"],"properties":{"effective_raters":{"type":"integer","minimum":0},"substantive_comments":{"type":"integer","minimum":0},"duplicate_comments":{"type":"integer","minimum":0},"owner_self_reviews":{"type":"integer","minimum":0},"average_stars_x100":{"type":"integer","minimum":0},"platform_quality_mean":{"type":"number"},"anomaly_flags":{"type":"array","items":{"type":"string"}}}},
    "vector": {"type":"object","additionalProperties":false,"required":["skill_id","capability_id","download_percentile","bayesian_stars_x100","review","platform_data_rich","maturity_version_count","evidence_cache_status"],"properties":{"skill_id":{"type":"string","minLength":1},"capability_id":{"type":"string","minLength":1},"download_percentile":{"type":"number","minimum":0,"maximum":1},"bayesian_stars_x100":{"type":"number","minimum":0},"review":{"$ref":"#/$defs/review"},"platform_data_rich":{"type":"boolean"},"maturity_version_count":{"type":"integer","minimum":0},"evidence_cache_status":{"type":"string"}}},
    "entry": {"type":"object","additionalProperties":false,"required":["skill_id","capability_id","lane","rank","reasons","evidence"],"properties":{"skill_id":{"type":"string","minLength":1},"capability_id":{"type":"string","minLength":1},"lane":{"enum":["DATA-RICH","EXPLORATION"]},"rank":{"type":"integer","minimum":1},"reasons":{"type":"array","items":{"type":"string"}},"evidence":{"$ref":"#/$defs/vector"}}},
    "gap": {"type":"object","additionalProperties":false,"required":["capability_id","wanted","selected","reason"],"properties":{"capability_id":{"type":"string","minLength":1},"wanted":{"type":"integer","minimum":0},"selected":{"type":"integer","minimum":0},"reason":{"type":"string"}}},
    "lexicon": {"type": "object", "additionalProperties": false, "required": ["contract", "version", "include_terms", "exclude_terms", "core_capabilities", "proposal_rules"], "properties": {"contract": {"const": "denova.xiaping-capability-lexicon"}, "version": {"const": "v1"}, "include_terms": {"type": "array", "items":{"type":"string","minLength":1}}, "exclude_terms": {"type": "array", "items":{"type":"string","minLength":1}}, "core_capabilities": {"type": "array", "items":{"$ref":"#/$defs/coreRule"}}, "proposal_rules": {"type": "array", "items":{"$ref":"#/$defs/proposalRule"}}}},
    "pageReceipt":{"type":"object","additionalProperties":false,"required":["kind","key","url","http_status","captured_at","sha256","item_count"],"properties":{"kind":{"type":"string","minLength":1},"key":{"type":"string","minLength":1},"url":{"type":"string","minLength":1},"http_status":{"type":"integer","minimum":0,"maximum":599},"captured_at":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"item_count":{"type":"integer","minimum":0},"error":{"type":"string"}}},
    "snapshotFailure":{"type":"object","additionalProperties":false,"required":["kind","key","disposition","message"],"properties":{"kind":{"type":"string","minLength":1},"key":{"type":"string","minLength":1},"disposition":{"type":"string","minLength":1},"message":{"type":"string","minLength":1}}},
    "coreRule":{"type":"object","additionalProperties":false,"required":["capability_id","terms"],"properties":{"capability_id":{"type":"string","minLength":1},"terms":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
    "proposalRule":{"type":"object","additionalProperties":false,"required":["capability_id","terms","name_zh","name_en","inputs","outputs","lifecycle_stage","minimum_permission","evaluation_method"],"properties":{"capability_id":{"type":"string","minLength":1},"terms":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"name_zh":{"type":"string","minLength":1},"name_en":{"type":"string","minLength":1},"inputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"outputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"lifecycle_stage":{"type":"string","minLength":1},"minimum_permission":{"type":"string","minLength":1},"evaluation_method":{"type":"string","minLength":1}}}
  }
}
