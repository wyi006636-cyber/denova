{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denova.example/schemas/review-issue-v1.schema.json",
  "title": "Denova ReviewIssue v1",
  "description": "Normative shape companion to ADR-RI-001; reference equality, byte hashes, and lifecycle continuity require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "issue_id", "capability_routing", "binding", "attachment",
    "location", "reader_evidence", "cause", "severity", "revision_layer",
    "recommendation", "reviewer_provenance", "reviewer_output_policy",
    "status", "status_history", "reverification_history"
  ],
  "properties": {
    "contract": { "$ref": "#/$defs/contract" },
    "issue_id": { "$ref": "#/$defs/id" },
    "capability_routing": { "$ref": "#/$defs/capabilityRouting" },
    "binding": { "$ref": "#/$defs/binding" },
    "attachment": { "$ref": "#/$defs/attachment" },
    "location": { "$ref": "#/$defs/location" },
    "reader_evidence": { "$ref": "#/$defs/readerEvidence" },
    "cause": { "$ref": "#/$defs/cause" },
    "severity": { "enum": ["blocking", "major", "moderate", "minor"] },
    "revision_layer": { "enum": ["fact", "structure", "scene", "character", "dialogue", "pacing", "language"] },
    "recommendation": { "$ref": "#/$defs/recommendation" },
    "reviewer_provenance": { "$ref": "#/$defs/provenance" },
    "reviewer_output_policy": { "$ref": "#/$defs/reviewerPolicy" },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": { "$ref": "#/$defs/status" },
    "status_history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/statusTransition" } },
    "reverification_history": { "type": "array", "items": { "$ref": "#/$defs/reverification" } }
  },
  "allOf": [
    {
      "if": { "properties": { "attachment": { "properties": { "kind": { "const": "finalized_artifact" } }, "required": ["kind"] } }, "required": ["attachment"] },
      "then": { "properties": { "attachment": { "required": ["finalization_receipt_id", "finalization_receipt_hash"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "verified_closed" } }, "required": ["status"] },
      "then": { "properties": { "reverification_history": { "minItems": 1, "contains": { "properties": { "result": { "const": "passed" } }, "required": ["result"] } } } }
    },
    {
      "if": { "properties": { "status": { "const": "reopened" } }, "required": ["status"] },
      "then": { "properties": { "reverification_history": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["kind", "version", "schema"],
      "properties": { "kind": { "const": "denova.review-issue" }, "version": { "const": "v1" }, "schema": { "const": "review-issue-v1.schema.json" } }
    },
    "capabilityId": { "enum": ["revision.fact", "revision.structure", "revision.scene", "revision.character", "revision.dialogue", "revision.pacing", "revision.language"] },
    "capabilityRouting": {
      "type": "object", "additionalProperties": false, "required": ["capability_id", "contract_version", "unknown_capability_id"],
      "properties": { "capability_id": { "$ref": "#/$defs/capabilityId" }, "contract_version": { "const": "v1" }, "unknown_capability_id": { "const": "reject_explicitly" } }
    },
    "workspaceBinding": {
      "type": "object", "additionalProperties": false, "required": ["workspace_id", "revision", "hash"],
      "properties": { "workspace_id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 0 }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "runBinding": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "contract_version"],
      "properties": { "run_id": { "$ref": "#/$defs/id" }, "contract_version": { "type": "string", "minLength": 1 } }
    },
    "stageBinding": {
      "type": "object", "additionalProperties": false, "required": ["stage_id", "stage_type", "contract_version"],
      "properties": { "stage_id": { "$ref": "#/$defs/id" }, "stage_type": { "type": "string", "minLength": 1 }, "contract_version": { "type": "string", "minLength": 1 } }
    },
    "artifactBinding": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "contract_version", "hash"],
      "properties": { "artifact_id": { "$ref": "#/$defs/id" }, "artifact_type": { "type": "string", "minLength": 1 }, "contract_version": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "versionedHashBinding": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "hash"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "profileBinding": {
      "type": "object", "additionalProperties": false, "required": ["profile_id", "contract_version", "hash"],
      "properties": { "profile_id": { "enum": ["long_serial", "fanqie_short", "zhihu_salt_short"] }, "contract_version": { "const": "v1" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "qualitySpecBinding": {
      "type": "object", "additionalProperties": false, "required": ["spec_id", "revision", "contract_version", "hash"],
      "properties": { "spec_id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "contract_version": { "const": "v1" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "run", "stage", "artifact", "candidate_set_id", "candidate_set_hash", "candidate_id", "candidate_content_hash", "source_manifest", "profile", "quality_spec", "reviewed_content_hash"],
      "properties": {
        "workspace": { "$ref": "#/$defs/workspaceBinding" }, "run": { "$ref": "#/$defs/runBinding" }, "stage": { "$ref": "#/$defs/stageBinding" },
        "artifact": { "$ref": "#/$defs/artifactBinding" }, "candidate_set_id": { "$ref": "#/$defs/id" }, "candidate_set_hash": { "$ref": "#/$defs/hash" },
        "candidate_id": { "$ref": "#/$defs/id" }, "candidate_content_hash": { "$ref": "#/$defs/hash" }, "source_manifest": { "$ref": "#/$defs/versionedHashBinding" },
        "profile": { "$ref": "#/$defs/profileBinding" }, "quality_spec": { "$ref": "#/$defs/qualitySpecBinding" }, "reviewed_content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false, "required": ["kind", "target_id", "target_hash"],
      "properties": { "kind": { "enum": ["candidate", "candidate_set", "finalized_artifact"] }, "target_id": { "$ref": "#/$defs/id" }, "target_hash": { "$ref": "#/$defs/hash" }, "finalization_receipt_id": { "$ref": "#/$defs/id" }, "finalization_receipt_hash": { "$ref": "#/$defs/hash" } }
    },
    "byteRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 } }
    },
    "location": {
      "type": "object", "additionalProperties": false, "required": ["artifact_path", "byte_range", "anchor_hash", "quoted_text_hash"],
      "properties": { "artifact_path": { "type": "string", "minLength": 1 }, "byte_range": { "$ref": "#/$defs/byteRange" }, "anchor_hash": { "$ref": "#/$defs/hash" }, "quoted_text_hash": { "$ref": "#/$defs/hash" } }
    },
    "evidenceExcerpt": {
      "type": "object", "additionalProperties": false, "required": ["quote", "location", "hash"],
      "properties": { "quote": { "type": "string", "minLength": 1 }, "location": { "$ref": "#/$defs/byteRange" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "readerEvidence": {
      "type": "object", "additionalProperties": false, "required": ["observable_effect", "summary", "excerpts"],
      "properties": { "observable_effect": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "excerpts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceExcerpt" } } }
    },
    "cause": {
      "type": "object", "additionalProperties": false, "required": ["category", "explanation"],
      "properties": { "category": { "enum": ["fact", "story_structure", "character", "scene", "information", "causality", "dialogue", "pacing", "language_style", "profile_fit"] }, "explanation": { "type": "string", "minLength": 1 } }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false, "required": ["minimum_impact_change", "affected_range", "dimensions_to_recheck"],
      "properties": { "minimum_impact_change": { "type": "string", "minLength": 1 }, "affected_range": { "$ref": "#/$defs/byteRange" }, "dimensions_to_recheck": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "source_kind", "source_version", "source_hash", "created_at"],
      "properties": { "source_id": { "$ref": "#/$defs/id" }, "source_kind": { "enum": ["reviewer", "skill", "author", "review_lead"] }, "source_version": { "type": "string", "minLength": 1 }, "source_hash": { "$ref": "#/$defs/hash" }, "created_at": { "$ref": "#/$defs/timestamp" } }
    },
    "reviewerPolicy": {
      "type": "object", "additionalProperties": false, "required": ["output", "writer_chain_of_thought", "formal_mutation_authority"],
      "properties": { "output": { "const": "evidence_and_findings_only" }, "writer_chain_of_thought": { "const": "forbidden" }, "formal_mutation_authority": { "const": false } }
    },
    "status": { "enum": ["open", "revision_proposed", "resolved", "verified_closed", "reopened", "dismissed"] },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actor_id", "actor_type"],
      "properties": { "actor_id": { "$ref": "#/$defs/id" }, "actor_type": { "enum": ["author", "reviewer", "review_lead", "system"] } }
    },
    "statusTransition": {
      "type": "object", "additionalProperties": false, "required": ["transition_id", "from", "to", "actor", "reason", "at", "reviewed_content_hash"],
      "properties": { "transition_id": { "$ref": "#/$defs/id" }, "from": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/status" }] }, "to": { "$ref": "#/$defs/status" }, "actor": { "$ref": "#/$defs/actor" }, "reason": { "type": "string", "minLength": 1 }, "at": { "$ref": "#/$defs/timestamp" }, "reviewed_content_hash": { "$ref": "#/$defs/hash" } },
      "oneOf": [
        { "properties": { "from": { "type": "null" }, "to": { "const": "open" } } },
        { "properties": { "from": { "const": "open" }, "to": { "enum": ["revision_proposed", "dismissed"] } } },
        { "properties": { "from": { "const": "revision_proposed" }, "to": { "enum": ["resolved", "open", "dismissed"] } } },
        { "properties": { "from": { "const": "resolved" }, "to": { "enum": ["verified_closed", "reopened"] } } },
        { "properties": { "from": { "const": "verified_closed" }, "to": { "const": "reopened" } } },
        { "properties": { "from": { "const": "reopened" }, "to": { "enum": ["revision_proposed", "dismissed"] } } },
        { "properties": { "from": { "const": "dismissed" }, "to": { "const": "reopened" } } }
      ],
      "allOf": [
        {
          "if": { "properties": { "to": { "const": "dismissed" } }, "required": ["to"] },
          "then": { "properties": { "actor": { "properties": { "actor_type": { "enum": ["author", "review_lead"] } } } } }
        }
      ]
    },
    "reverification": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "result", "revised_content_hash", "evidence", "verifier_provenance", "at"],
      "properties": { "attempt_id": { "$ref": "#/$defs/id" }, "result": { "enum": ["passed", "failed"] }, "revised_content_hash": { "$ref": "#/$defs/hash" }, "evidence": { "type": "string", "minLength": 1 }, "verifier_provenance": { "$ref": "#/$defs/provenance" }, "at": { "$ref": "#/$defs/timestamp" } }
    }
  }
}
