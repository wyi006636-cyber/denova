{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denova.example/schemas/profile-v1.schema.json",
  "title": "Denova Quality Profile v1",
  "description": "Normative machine-readable companion to ADR-PROFILE-001. All profiles use one shared engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile_id",
    "display_name",
    "engine_contract",
    "profile_provenance",
    "identity_policy",
    "settings",
    "walkthrough",
    "quality_spec"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "issued_at"],
      "properties": {
        "kind": { "const": "denova.quality-profile" },
        "version": { "const": "v1" },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "profile_id": { "$ref": "#/$defs/profileId" },
    "display_name": { "$ref": "#/$defs/localizedText" },
    "engine_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "contract_version", "implementation_branching"],
      "properties": {
        "engine_id": { "const": "denova.shared-quality-engine" },
        "contract_version": { "const": "v1" },
        "implementation_branching": { "const": "profile_data_only" }
      }
    },
    "profile_provenance": { "$ref": "#/$defs/provenance" },
    "identity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_profile_id", "silent_fallback", "model_mutation"],
      "properties": {
        "unknown_profile_id": { "const": "reject_explicitly" },
        "silent_fallback": { "const": false },
        "model_mutation": { "const": "candidate_only" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_artifacts",
        "required_capabilities",
        "candidate_policy",
        "review_rubric",
        "export_config"
      ],
      "properties": {
        "required_artifacts": { "$ref": "#/$defs/settingList" },
        "required_capabilities": { "$ref": "#/$defs/settingList" },
        "candidate_policy": { "$ref": "#/$defs/settingList" },
        "review_rubric": { "$ref": "#/$defs/settingList" },
        "export_config": { "$ref": "#/$defs/settingList" }
      }
    },
    "walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "artifact_ref", "description", "evaluation_focus"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/localizedText" },
        "evaluation_focus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^qg\\.[a-z0-9][a-z0-9._-]{2,127}$" }
        }
      }
    },
    "quality_spec": { "$ref": "quality-spec-v1.schema.json" }
  },
  "$defs": {
    "profileId": {
      "enum": ["long_serial", "fanqie_short", "zhihu_salt_short"]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_kind", "source_ref", "observed_at", "effective_from", "recorded_at"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "source_kind": { "enum": ["approved_plan", "platform_observation", "author", "project_contract"] },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "observed_at": { "type": "string", "format": "date" },
        "effective_from": { "type": "string", "format": "date" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "authorOverridePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "allowed_scopes", "requires_explicit_confirmation", "unsupported_value_policy"],
      "properties": {
        "allowed": { "type": "boolean" },
        "allowed_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["project", "task", "operation_confirmation"] }
        },
        "requires_explicit_confirmation": { "const": true },
        "unsupported_value_policy": { "const": "reject_explicitly" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "provenance", "author_override_policy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
        "value": { "type": ["string", "number", "integer", "boolean", "array", "object"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "author_override_policy": { "$ref": "#/$defs/authorOverridePolicy" }
      }
    },
    "settingList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setting" }
    }
  }
}
