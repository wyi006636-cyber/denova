{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denova.example/schemas/quality-spec-v1.schema.json",
  "title": "Denova QualitySpec v1",
  "description": "Normative machine-readable companion to ADR-QS-001. The ADR remains the semantic authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "spec_id",
    "revision",
    "profile_id",
    "goal_catalog",
    "layers",
    "candidate_changes",
    "resolution"
  ],
  "properties": {
    "contract": { "$ref": "#/$defs/specContract" },
    "spec_id": { "type": "string", "pattern": "^qs-[a-z0-9][a-z0-9._-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "profile_id": { "$ref": "#/$defs/profileId" },
    "goal_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/qualityGoal" }
    },
    "layers": { "$ref": "#/$defs/layers" },
    "candidate_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateChange" }
    },
    "resolution": { "$ref": "#/$defs/resolution" }
  },
  "$defs": {
    "profileId": {
      "enum": ["long_serial", "fanqie_short", "zhihu_salt_short"]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "specContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "issued_at"],
      "properties": {
        "kind": { "const": "denova.quality-spec" },
        "version": { "const": "v1" },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "goalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": { "const": "denova.quality-goal" },
        "version": { "const": "v1" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "source_ref",
        "observed_at",
        "effective_from",
        "recorded_at"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "source_kind": {
          "enum": [
            "author",
            "approved_plan",
            "profile_contract",
            "platform_observation",
            "project_contract",
            "task_contract",
            "model_proposal"
          ]
        },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "observed_at": { "type": "string", "format": "date" },
        "effective_from": { "type": "string", "format": "date" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "decision", "confirmation_id", "confirmed_at"],
      "properties": {
        "actor": { "const": "author" },
        "decision": { "const": "confirmed" },
        "confirmation_id": { "type": "string", "pattern": "^confirm-[a-z0-9][a-z0-9._-]{2,127}$" },
        "confirmed_at": { "type": "string", "format": "date-time" }
      }
    },
    "authorOverridePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "allowed_scopes",
        "requires_explicit_confirmation",
        "forbidden_operations",
        "unsupported_value_policy"
      ],
      "properties": {
        "allowed": { "type": "boolean" },
        "allowed_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["project", "task", "operation_confirmation"] }
        },
        "requires_explicit_confirmation": { "const": true },
        "forbidden_operations": {
          "const": ["delete"]
        },
        "unsupported_value_policy": { "const": "reject_explicitly" }
      }
    },
    "qualityGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract",
        "description",
        "source",
        "purpose",
        "scope",
        "priority",
        "evidence_requirement",
        "value_contract",
        "allowed_override_scopes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^qg\\.[a-z0-9][a-z0-9._-]{2,127}$" },
        "contract": { "$ref": "#/$defs/goalContract" },
        "description": { "$ref": "#/$defs/localizedText" },
        "source": { "$ref": "#/$defs/provenance" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_ids", "operation_ids", "artifact_types"],
          "properties": {
            "profile_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/profileId" }
            },
            "operation_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "artifact_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "priority": { "enum": ["must", "should", "could"] },
        "evidence_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "minimum_count", "accepted_sources"],
          "properties": {
            "kind": { "enum": ["text_span", "structural_check", "author_judgment", "source_crosscheck"] },
            "description": { "$ref": "#/$defs/localizedText" },
            "minimum_count": { "type": "integer", "minimum": 1 },
            "accepted_sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["manuscript", "outline", "lore", "author_note", "review_artifact"] }
            }
          }
        },
        "value_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "allowed_values", "unknown_value_policy"],
          "properties": {
            "type": { "enum": ["boolean", "integer", "number", "string", "enum"] },
            "allowed_values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": ["string", "number", "integer", "boolean"] }
            },
            "unknown_value_policy": { "const": "reject_explicitly" }
          }
        },
        "allowed_override_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["project", "task", "operation_confirmation"] }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "value", "provenance", "author_override_policy"],
      "properties": {
        "goal_id": { "type": "string", "pattern": "^qg\\.[a-z0-9][a-z0-9._-]{2,127}$" },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "author_override_policy": { "$ref": "#/$defs/authorOverridePolicy" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "operation", "value", "scope", "provenance", "authorization"],
      "properties": {
        "goal_id": { "type": "string", "pattern": "^qg\\.[a-z0-9][a-z0-9._-]{2,127}$" },
        "operation": { "const": "set" },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "scope": { "enum": ["project", "task", "operation_confirmation"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_defaults", "project_overrides", "task_overrides", "operation_confirmation"],
      "properties": {
        "profile_defaults": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        },
        "project_overrides": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/override" },
              { "properties": { "scope": { "const": "project" } } }
            ]
          }
        },
        "task_overrides": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/override" },
              { "properties": { "scope": { "const": "task" } } }
            ]
          }
        },
        "operation_confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "authorization", "overrides"],
          "properties": {
            "operation_id": { "type": "string", "minLength": 1 },
            "authorization": { "$ref": "#/$defs/authorization" },
            "overrides": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/override" },
                  { "properties": { "scope": { "const": "operation_confirmation" } } }
                ]
              }
            }
          }
        }
      }
    },
    "candidateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "proposed_by", "status", "applied", "proposal", "provenance"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^candidate-[a-z0-9][a-z0-9._-]{2,127}$" },
        "proposed_by": { "enum": ["model", "skill", "automation"] },
        "status": { "const": "candidate_only" },
        "applied": { "const": false },
        "proposal": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resolutionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "value", "provenance"],
      "properties": {
        "layer": { "enum": ["profile_defaults", "project_overrides", "task_overrides", "operation_confirmation"] },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "resolvedGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "value",
        "winning_layer",
        "provenance_chain",
        "author_confirmation_id"
      ],
      "properties": {
        "goal_id": { "type": "string", "pattern": "^qg\\.[a-z0-9][a-z0-9._-]{2,127}$" },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "winning_layer": { "enum": ["profile_defaults", "project_overrides", "task_overrides", "operation_confirmation"] },
        "provenance_chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolutionStep" }
        },
        "author_confirmation_id": { "type": "string", "pattern": "^confirm-[a-z0-9][a-z0-9._-]{2,127}$" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_order",
        "unknown_or_unsupported_value_policy",
        "validator_contract",
        "validated_at",
        "resolved_goals"
      ],
      "properties": {
        "merge_order": {
          "type": "array",
          "prefixItems": [
            { "const": "profile_defaults" },
            { "const": "project_overrides" },
            { "const": "task_overrides" },
            { "const": "operation_confirmation" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "unknown_or_unsupported_value_policy": { "const": "reject_explicitly" },
        "validator_contract": { "const": "quality-spec-resolution-v1" },
        "validated_at": { "type": "string", "format": "date-time" },
        "resolved_goals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolvedGoal" }
        }
      }
    }
  }
}
